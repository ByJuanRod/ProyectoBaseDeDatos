@startuml
' Configuración visual
hide circle
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 50

' =============================================
' TABLAS INDEPENDIENTES
' =============================================

entity "usuarios" as usuarios {
  * nombre_usuario : VARCHAR(50) <<PK>>
  --
  contrasena : VARCHAR(255)
  tipo : VARCHAR(30)
}

entity "centros_empleadores" as centros_empleadores {
  * codigo : VARCHAR(20) <<PK>>
  --
  rnc : VARCHAR(20)
  nombre : VARCHAR(150)
  sector : VARCHAR(100)
  provincia : VARCHAR(100)
  municipio : VARCHAR(100)
  telefono : VARCHAR(20)
  correo : VARCHAR(150)
}

' =============================================
' TABLAS DE CANDIDATOS (HERENCIA)
' =============================================

entity "candidatos" as candidatos {
  * codigo : VARCHAR(20) <<PK>>
  --
  tipo_candidato : ENUM
  identificacion : VARCHAR(20)
  nombres : VARCHAR(100)
  apellidos : VARCHAR(100)
  fecha_nacimiento : DATE
  genero : VARCHAR(20)
  provincia : VARCHAR(100)
  municipio : VARCHAR(100)
  telefono : VARCHAR(20)
  correo : VARCHAR(150)
  jornada : VARCHAR(50)
  modalidad : VARCHAR(50)
  area_de_interes : VARCHAR(100)
  aspiracion_salarial : FLOAT
  licencia_conducir : BOOLEAN
  disposicion_mudarse : BOOLEAN
  estado : VARCHAR(30)
}

entity "candidato_idiomas" as candidato_idiomas {
  * candidato_codigo : VARCHAR(20) <<FK>>
  * idioma : VARCHAR(50)
}

' Subtipos de candidatos
entity "obreros" as obreros {
  * codigo : VARCHAR(20) <<PK, FK>>
}

entity "obrero_habilidades" as obrero_habilidades {
  * obrero_codigo : VARCHAR(20) <<FK>>
  * habilidad : VARCHAR(100)
}

entity "tecnicos_superiores" as tecnicos_superiores {
  * codigo : VARCHAR(20) <<PK, FK>>
  --
  area_tecnica : VARCHAR(100)
  anios_experiencia : INT
}

entity "universitarios" as universitarios {
  * codigo : VARCHAR(20) <<PK, FK>>
  --
  universidad : VARCHAR(150)
  carrera : VARCHAR(150)
  nivel_academico : VARCHAR(50)
}

' =============================================
' OFERTAS LABORALES
' =============================================

entity "ofertas_laborales" as ofertas_laborales {
  * codigo : VARCHAR(20) <<PK>>
  --
  puesto : VARCHAR(150)
  descripcion : TEXT
  area : VARCHAR(100)
  modalidad : VARCHAR(50)
  jornada : VARCHAR(50)
  estado : VARCHAR(30)
  salario : FLOAT
  experiencia_minima : INT
  vacantes : INT
  centro_codigo : VARCHAR(20) <<FK>>
  ofrece_reubicacion : BOOLEAN
  obligatorio_mayor_edad : BOOLEAN
  obligatorio_licencia : BOOLEAN
  nivel_academico : VARCHAR(50)
  porcentaje_minimo : INT
}

entity "oferta_requisitos" as oferta_requisitos {
  * oferta_codigo : VARCHAR(20) <<FK>>
  * requisito : VARCHAR(150)
  --
  orden : INT
}

entity "oferta_idiomas" as oferta_idiomas {
  * oferta_codigo : VARCHAR(20) <<FK>>
  * idioma : VARCHAR(50)
}

' =============================================
' SOLICITUDES Y CONTRATACIONES
' =============================================

entity "solicitudes" as solicitudes {
  * codigo : VARCHAR(20) <<PK>>
  --
  fecha_solicitud : DATE
  estado : VARCHAR(30)
  candidato_codigo : VARCHAR(20) <<FK>>
  oferta_codigo : VARCHAR(20) <<FK>>
}

entity "vacantes_completadas" as vacantes_completadas {
  * codigo : VARCHAR(20) <<PK>>
  --
  solicitud_codigo : VARCHAR(20) <<FK>>
  oferta_codigo : VARCHAR(20) <<FK>>
  fecha_contratacion : DATE
}

' =============================================
' RELACIONES (FOREIGN KEYS Y HERENCIA)
' =============================================

' Atributos multivaluados de candidatos
candidatos ||--o{ candidato_idiomas : "domina"

' Herencia de Candidatos
candidatos ||--|| obreros : "es"
candidatos ||--|| tecnicos_superiores : "es"
candidatos ||--|| universitarios : "es"

obreros ||--o{ obrero_habilidades : "posee"

' Centros y Ofertas
centros_empleadores ||--o{ ofertas_laborales : "publica"

' Atributos de Ofertas
ofertas_laborales ||--o{ oferta_requisitos : "requiere"
ofertas_laborales ||--o{ oferta_idiomas : "exige"

' Solicitudes
candidatos ||--o{ solicitudes : "aplica a"
ofertas_laborales ||--o{ solicitudes : "recibe"

' Vacantes Completadas
solicitudes ||--o| vacantes_completadas : "se convierte en"
ofertas_laborales ||--o{ vacantes_completadas : "cubre"

@enduml