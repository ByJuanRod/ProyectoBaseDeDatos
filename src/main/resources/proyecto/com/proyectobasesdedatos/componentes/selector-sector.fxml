<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="proyecto.com.proyectobasesdedatos.controladores.componentes.SelectorSectorController"
            prefWidth="780.0" prefHeight="600.0">

    <VBox spacing="12.0" AnchorPane.topAnchor="16.0" AnchorPane.bottomAnchor="16.0"
          AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0">

        <Label text="Selector de Sectores" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <TextField fx:id="txtFiltrar" promptText="Buscar por código, nombre o municipio..."
                   onKeyReleased="#txtFiltrarKeyReleased"/>

        <TableView fx:id="tblSectores" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="100.0"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="300.0"/>
                <TableColumn fx:id="colMunicipio" text="Municipio" prefWidth="300.0"/>
            </columns>
        </TableView>

        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <Button text="Cerrar" onAction="#btnCerrarClick"/>
            <Button text="Seleccionar" onAction="#btnSeleccionarClick" defaultButton="true"/>
        </HBox>

    </VBox>

</AnchorPane>
