<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proyecto.com.proyectobasesdedatos.controladores.componentes.SeleccionAsientosController">

    <!-- Encabezado - Ancho ajustado -->
    <AnchorPane layoutX="35.0" layoutY="24.0" prefHeight="110.0" prefWidth="880.0" style="-fx-background-color: #111F35; -fx-background-radius: 10px;" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
        <Circle fill="#f63049" layoutX="47.0" layoutY="55.0" radius="33.0" stroke="WHITE" strokeType="INSIDE" />
        <ImageView fitHeight="50.0" fitWidth="50.0" layoutX="22.0" layoutY="30.0" pickOnBounds="true" preserveRatio="true">
            <Image url="@../imagenes/salas.png" />
        </ImageView>
        <Label layoutX="96.0" layoutY="34.0" text="Selección de Asientos" textFill="WHITE">
            <font>
                <Font name="Century Gothic Bold" size="32.0" />
            </font>
        </Label>
        <Line endX="300.0" endY="-7.62939453125E-6" layoutX="197.0" layoutY="80.0" startX="-100.0" stroke="WHITE" />
        <Label fx:id="lblSala" alignment="CENTER" layoutX="610.0" layoutY="33.0" prefHeight="42.0" prefWidth="240.0" text="Sala 10" textFill="#ffc400">
            <font>
                <Font name="Century Gothic Bold" size="32.0" />
            </font>
        </Label>
        <Line endX="100.0" layoutX="730.0" layoutY="80.0" startX="-99.5999755859375" startY="-7.62939453125E-6" stroke="#ffc400" />
    </AnchorPane>

    <!-- Botón Cerrar - Posición ajustada con AnchorPane -->
    <Button layoutX="700.0" layoutY="540.0" mnemonicParsing="false" onAction="#btnCerrarClick" prefHeight="43.0" prefWidth="240.0" style="-fx-background-color: #D62828; -fx-background-radius: 10px;" text="Cerrar" textFill="WHITE" AnchorPane.bottomAnchor="17.0" AnchorPane.rightAnchor="10.0">
        <font>
            <Font name="Century Gothic Bold" size="18.0" />
        </font>
        <cursor>
            <Cursor fx:constant="HAND" />
        </cursor>
        <graphic>
            <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" translateX="-25.0">
                <Image url="@../imagenes/cerrar.png" />
            </ImageView>
        </graphic>
    </Button>

    <!-- ScrollPane para los asientos - Altura aumentada -->
    <ScrollPane layoutX="18.0" layoutY="129.0" prefHeight="420.0" prefWidth="620.0" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
        <FlowPane fx:id="pnlContenedor" alignment="CENTER" prefWrapLength="600">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </FlowPane>
    </ScrollPane>

    <!-- Panel lateral derecho - Altura aumentada para coincidir -->
    <AnchorPane layoutX="650.0" layoutY="129.0" prefHeight="393.0" prefWidth="240.0" style="-fx-background-color: #111F35; -fx-background-radius: 10px;" AnchorPane.bottomAnchor="78.0" AnchorPane.rightAnchor="10.0">

        <Label layoutX="70.0" layoutY="14.0" text="Función" textFill="WHITE">
            <font>
                <Font name="Century Gothic Bold" size="24.0" />
            </font>
        </Label>
        <Line endX="100.0" layoutX="96.0" layoutY="54.0" startX="-56.79999923706055" startY="0.1999969482421875" stroke="WHITE" />
        <Label fx:id="lblFuncion" layoutX="48.0" layoutY="68.0" text="[CODIGO]" textFill="#ffc400">
            <font>
                <Font name="Century Gothic Bold" size="24.0" />
            </font>
        </Label>
        <Line endX="100.0" layoutX="93.0" layoutY="111.0" startX="-56.79999923706055" startY="0.1999969482421875" stroke="WHITE" />

        <!-- Leyenda de colores - Colores originales -->
        <Circle fill="#31694e" layoutX="45.0" layoutY="150.0" radius="12.0" stroke="#fffafa" strokeType="INSIDE" />
        <Circle fill="#E4B028" layoutX="45.0" layoutY="192.0" radius="12.0" stroke="WHITE" strokeType="INSIDE" />
        <Circle fill="#d62828" layoutX="45.0" layoutY="234.0" radius="12.0" stroke="WHITE" strokeType="INSIDE" />

        <Label layoutX="70.0" layoutY="138.0" text="Disponible" textFill="WHITE">
            <font>
                <Font name="Century Gothic" size="18.0" />
            </font>
        </Label>
        <Label layoutX="70.0" layoutY="180.0" text="Seleccionado" textFill="WHITE">
            <font>
                <Font name="Century Gothic" size="18.0" />
            </font>
        </Label>
        <Label layoutX="70.0" layoutY="222.0" text="No disponible" textFill="WHITE">
            <font>
                <Font name="Century Gothic" size="18.0" />
            </font>
        </Label>

        <!-- Separador -->
        <Line endX="200.0" layoutX="20.0" layoutY="270.0" startX="-20.0" startY="0.0" stroke="#555555" />

        <Label layoutX="44.0" layoutY="285.0" text="Seleccionados:" textFill="WHITE">
            <font>
                <Font name="Century Gothic" size="16.0" />
            </font>
        </Label>
        <Label fx:id="lblSeleccionados" layoutX="174.0" layoutY="285.0" text="0" textFill="#ffc400">
            <font>
                <Font name="Century Gothic Bold" size="18.0" />
            </font>
        </Label>

        <!-- Botón Confirmar - Posición ajustada -->
        <Button layoutX="20.0" layoutY="330.0" mnemonicParsing="false" onAction="#btnConfirmarClick" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #F63049; -fx-background-radius: 10px;" text="Confirmar" textFill="WHITE">
            <font>
                <Font name="Century Gothic Bold" size="18.0" />
            </font>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
            <graphic>
                <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" translateX="-25.0">
                    <Image url="@../imagenes/ticket.png" />
                </ImageView>
            </graphic>
        </Button>
    </AnchorPane>
</AnchorPane>
